AZURE_OPENAI_API_KEY="Place your Azure OpenAI API key here"
AZURE_OPENAI_ENDPOINT="Place your Azure OpenAI endpoint here"
AZURE_OPENAI_DEPLOYMENT_NAME="Place your Azure OpenAI deployment name here"
AZURE_OPENAI_API_VERSION="Place your Azure OpenAI API version here"
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME="Place your Azure OpenAI embedding deployment name here"

# Authentication
JWT_SECRET_KEY="Place your JWT secret key here"
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Email verification
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-sender@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM_EMAIL=your-sender@gmail.com
SMTP_USE_TLS=true

# Application
APP_BASE_URL=http://127.0.0.1:8000

# Chroma settings for storing Embeddings
CHROMA_PERSIST_DIRECTORY=data/chroma_db
CHROMA_COLLECTION_NAME=assistant_memories
